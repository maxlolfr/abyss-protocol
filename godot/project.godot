config_version=5

[application]
config/name="ABYSS PROTOCOL — prototype Godot"
run/main_scene="res://view/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.027, 0.051, 0.086, 1)
boot_splash/image="res://assets/ui/screens/loading.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048

[gui]

theme/custom_font="res://assets/ui/fonts/Rajdhani-SemiBold.ttf"
